#!/usr/bin/env bash
set -euo pipefail

IMAGE="claude-docker:latest"

# Portable alternative to readlink -f (which is unavailable on macOS)
resolve_path() {
    local target="$1"
    cd "$(dirname "$target")"
    target="$(basename "$target")"
    while [[ -L "$target" ]]; do
        target="$(readlink "$target")"
        cd "$(dirname "$target")"
        target="$(basename "$target")"
    done
    echo "$(pwd -P)/$target"
}
SCRIPT_DIR="$(dirname "$(resolve_path "${BASH_SOURCE[0]}")")"

# Load local config (gitignored); fall back to defaults
CLIPBOARD_FORWARDING=false
if [[ -f "$SCRIPT_DIR/claude-docker.env" ]]; then
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/claude-docker.env"
fi

# Build the image if it doesn't exist or if --build (or an alias) is passed
case "${1:-}" in
    --build|--upgrade|--update|upgrade|update) FORCE_BUILD=true ;;
    *) FORCE_BUILD=false ;;
esac
if [[ "$FORCE_BUILD" == true ]]; then
    shift
    docker build --no-cache -f "$SCRIPT_DIR/Dockerfile" -t "$IMAGE" "$SCRIPT_DIR"
    exit 0
elif ! docker image inspect "$IMAGE" &>/dev/null; then
    echo "Image $IMAGE not found. Building..." >&2
    docker build -f "$SCRIPT_DIR/Dockerfile" -t "$IMAGE" "$SCRIPT_DIR"
fi

# Always pass host UID/GID to the container.
# macOS (OrbStack/Docker Desktop) handles user mapping transparently, so -u is not strictly
# needed there, but empty array expansion fails with set -euo pipefail.
# So USER_ARGS is always populated for consistency and to avoid expansion errors on all platforms.
OS="$(uname -s)"
USER_ARGS=(-u "$(id -u):$(id -g)")
for gid in $(id -G); do
    USER_ARGS+=(--group-add "$gid")
done

# Let's persist the claude files or share the existing config
mkdir -p "$HOME/.claude"

CLAUDE_JSON_ARGS=()
if [[ -f "$HOME/.claude.json" ]]; then
    CLAUDE_JSON_ARGS+=(-v "$HOME/.claude.json:$HOME/.claude.json")
fi

# Clipboard forwarding so Ctrl+V image paste works inside the container
CLIPBOARD_ARGS=()
if [[ "$CLIPBOARD_FORWARDING" == "true" && "$OS" != "Darwin" ]]; then
    if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
        # Wayland: mount the socket so wl-paste can reach it
        CLIPBOARD_ARGS+=(
            -e WAYLAND_DISPLAY="$WAYLAND_DISPLAY"
            -e XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR"
            -v "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
        )
    elif [[ -n "${DISPLAY:-}" ]]; then
        # X11: forward display + authority file so xclip can reach the X server
        CLIPBOARD_ARGS+=(
            -e DISPLAY="$DISPLAY"
            -v /tmp/.X11-unix:/tmp/.X11-unix
        )
        if [[ -f "${XAUTHORITY:-$HOME/.Xauthority}" ]]; then
            CLIPBOARD_ARGS+=(
                -e XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
                -v "${XAUTHORITY:-$HOME/.Xauthority}:${XAUTHORITY:-$HOME/.Xauthority}"
            )
        fi
    fi
fi

# macOS has no display socket to forward: run a host-side bridge instead that
# answers the container's xclip shim with the clipboard image (images only).
# Ctrl+V: xclip-shim.sh writes <id>.req, this loop answers <id>.png or <id>.none.
# The bridge dir lives under ~/.claude, which is already mounted. The container
# runs with your UID, so both sides can create and delete the request/response files.
CLIPBOARD_BRIDGE_PID=""
CLIPBOARD_BRIDGE_DIR=""
if [[ "$CLIPBOARD_FORWARDING" == "true" && "$OS" == "Darwin" ]]; then
    mkdir -p "$HOME/.claude/docker"
    CLIPBOARD_BRIDGE_DIR="$(mktemp -d "$HOME/.claude/docker/clipboard.XXXXXX")"
    (
        wrapper_pid=$$
        while kill -0 "$wrapper_pid" 2>/dev/null; do
            for req in "$CLIPBOARD_BRIDGE_DIR"/*.req; do
                [[ -e "$req" ]] || continue
                id="$(basename "$req" .req)"
                rm -f "$req"
                # «class PNGf» converts any clipboard image to PNG; fails if none.
                # Written to .tmp then renamed so the shim never reads a partial file.
                if osascript \
                    -e 'on run argv' \
                    -e 'set img to the clipboard as «class PNGf»' \
                    -e 'set f to open for access (POSIX file (item 1 of argv)) with write permission' \
                    -e 'write img to f' \
                    -e 'close access f' \
                    -e 'end run' \
                    "$CLIPBOARD_BRIDGE_DIR/$id.tmp" >/dev/null 2>&1; then
                    mv "$CLIPBOARD_BRIDGE_DIR/$id.tmp" "$CLIPBOARD_BRIDGE_DIR/$id.png"
                else
                    rm -f "$CLIPBOARD_BRIDGE_DIR/$id.tmp"
                    : > "$CLIPBOARD_BRIDGE_DIR/$id.none"
                fi
            done
            sleep 0.1
        done
    ) &
    CLIPBOARD_BRIDGE_PID=$!
    CLIPBOARD_ARGS+=(-e CLAUDE_DOCKER_CLIPBOARD_DIR="$CLIPBOARD_BRIDGE_DIR")
fi

cleanup_clipboard_bridge() {
    [[ -n "$CLIPBOARD_BRIDGE_PID" ]] && kill "$CLIPBOARD_BRIDGE_PID" 2>/dev/null
    [[ -n "$CLIPBOARD_BRIDGE_DIR" ]] && rm -rf "$CLIPBOARD_BRIDGE_DIR"
    return 0
}
trap cleanup_clipboard_bridge EXIT

# If the OAuth token expires within the next hour, trigger a host-side refresh
# before launching. The container has no keychain access and cannot refresh
# tokens itself — only the host claude binary can reach the system keychain.
# Access tokens only live ~8h, so seeing this on the first launch of the day
# is expected; what matters is that the expiry moves forward afterwards.
CREDS_FILE="$HOME/.claude/.credentials.json"
token_expires_in() {
    # Scope to the claudeAiOauth object: the file may also contain mcpOAuth
    # entries with their own (often 0) expiresAt that appear earlier in the file,
    # and a bare `head -1` would grab those instead of the real session token.
    local exp_ms
    exp_ms=$(grep -o '"claudeAiOauth":{[^}]*}' "$CREDS_FILE" 2>/dev/null | grep -o '"expiresAt":[0-9]*' | head -1 | cut -d: -f2)
    echo $(( ${exp_ms:-0} / 1000 - $(date +%s) ))
}
fmt_delta() {
    local s=$1
    if (( s < 0 )); then echo "expired $(( -s / 60 ))m ago"; else echo "expires in $(( s / 60 ))m"; fi
}
if [[ -f "$CREDS_FILE" ]]; then
    _expires_in=$(token_expires_in)
    if (( _expires_in < 3600 )); then
        # Resolve the real host binary: if `claude` is this wrapper (alias or
        # symlink), `claude -p` would run in a container and could never refresh.
        _host_claude=$(command -v claude || true)
        if [[ -n "$_host_claude" && "$(readlink -f "$_host_claude")" != "$(readlink -f "${BASH_SOURCE[0]}")" ]]; then
            echo "OAuth token $(fmt_delta "$_expires_in") — refreshing on host..." >&2
            claude -p "reply with exactly: token refresh ok" </dev/null >/dev/null 2>&1
            _rc=$?
            _new_expires_in=$(token_expires_in)
            if (( _new_expires_in > _expires_in && _new_expires_in > 0 )); then
                echo "Token refreshed — $(fmt_delta "$_new_expires_in")." >&2
            else
                echo "Warning: token refresh did not update $CREDS_FILE (exit $_rc, token $(fmt_delta "$_new_expires_in")) — run 'claude' on the host and /login if needed." >&2
            fi
        else
            echo "Warning: OAuth token $(fmt_delta "$_expires_in") and no host claude binary found — you may get 401 errors." >&2
        fi
    fi
fi

TTY_ARGS=()
[[ -t 0 && -t 1 ]] && TTY_ARGS+=(-t)

# Not exec'd: the wrapper must outlive the container to clean up the bridge
docker run --rm -i ${TTY_ARGS[@]+"${TTY_ARGS[@]}"} \
    --dns-opt single-request \
    ${USER_ARGS[@]+"${USER_ARGS[@]}"} \
    -v "$(pwd):$(pwd)" \
    -w "$(pwd)" \
    -e HOME="$HOME" \
    -e USER="${USER:-$(id -un)}" \
    ${ANTHROPIC_API_KEY:+-e ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY"} \
    ${CLAUDE_CODE_OAUTH_TOKEN:+-e CLAUDE_CODE_OAUTH_TOKEN="$CLAUDE_CODE_OAUTH_TOKEN"} \
    -v "$HOME/.claude:$HOME/.claude" \
    ${CLAUDE_JSON_ARGS[@]+"${CLAUDE_JSON_ARGS[@]}"} \
    ${CLIPBOARD_ARGS[@]+"${CLIPBOARD_ARGS[@]}"} \
    "$IMAGE" \
    "$@"
